local function applyStyle(inst, cornerRadius, hasStroke, strokeColor)
	if cornerRadius then
		local corner = inst:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, cornerRadius)
		corner.Parent = inst
	end
	if hasStroke then
		local stroke = inst:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
		stroke.Color = strokeColor or STYLES.StrokeColor
		stroke.Thickness = 1
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = inst
	end
end

local function createStyledBtn(text, parent, height, strokeColor)
	height = height or BTN_H
	local btn = Instance.new("TextButton")
	btn.Text = text
	btn.Size = UDim2.new(CONTENT_WIDTH, 0, 0, height)
	btn.BackgroundColor3 = STYLES.CardColor
	btn.TextColor3 = STYLES.TextColor
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 10
	btn.TextWrapped = true
	btn.AutoButtonColor = true
	btn.Parent = parent
	applyStyle(btn, 4, true, strokeColor)
	return btn
end

local function createLabel(text, parent, height, fontSize)
	local lbl = Instance.new("TextLabel")
	lbl.Text = text
	lbl.Size = UDim2.new(CONTENT_WIDTH, 0, 0, height or 14)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = STYLES.TextColor
	lbl.Font = Enum.Font.SourceSans
	lbl.TextSize = fontSize or 10
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Center
	lbl.Parent = parent
	return lbl
end

