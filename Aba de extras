-- ====================== HELPERS RH ======================
local function rh_getChar() return LP.Character end

local function rh_obterChaoInfo(pos)
	local rp = RaycastParams.new()
	rp.FilterDescendantsInstances = {LP.Character}
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local hit = workspace:Raycast(pos + Vector3.new(0,10,0), Vector3.new(0,-30,0), rp)
	if hit then return hit.Position, hit.Instance end
	return pos - Vector3.new(0,3,0), workspace.Terrain
end

local function rh_pegarMeusProps()
	local out = {}
	local wsc = workspace:FindFirstChild("WorkspaceCom")
	if not wsc then return out end
	local function scan(p)
		for _, c in ipairs(p:GetChildren()) do
			if c:IsA("Model") and c.Name:sub(1, #("Prop"..OwnerName)) == ("Prop"..OwnerName) then
				table.insert(out, c)
			end
			scan(c)
		end
	end
	scan(wsc)
	return out
end

local function rh_getGridPosition(index)
	local char = rh_getChar()
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local row = math.floor((index - 1) / SPAWN_GRID_ROW)
	local col = (index - 1) % SPAWN_GRID_ROW
	local xOffset = (col - 2) * 6
	local zOffset = 8 + row * 6
	local basePos = hrp.Position + hrp.CFrame.LookVector * zOffset + hrp.CFrame.RightVector * xOffset
	return rh_obterChaoInfo(basePos)
end

local function rh_spawnPropAt(posChao, chaoPart)
	local char = rh_getChar()
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local bp = LP:FindFirstChild("Backpack")
	local pm = char:FindFirstChild("PropMaker") or (bp and bp:FindFirstChild("PropMaker"))
	if not pm then return nil end
	if pm.Parent ~= char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function() hum:EquipTool(pm) end)
		end
		for _ = 1, 30 do
			task.wait(0.05)
			if char:FindFirstChild("PropMaker") then break end
		end
		if not char:FindFirstChild("PropMaker") then
			pcall(function() pm.Parent = char end)
			task.wait(0.15)
		end
	end
	local tool = char:FindFirstChild("PropMaker")
	if not tool then return nil end
	local tmake = tool:FindFirstChild("Tool_PropMake")
	if not tmake then return nil end
	local antigos = rh_pegarMeusProps()
	pcall(function()
		ReplicatedStorage.Remotes.TelemetryClientInteraction:FireServer("filterClick", {
			["name"] = PROP_NAME_RH, ["itemType"] = "Props", ["filter"] = PROP_FILTER_RH,
		})
	end)
	task.wait(0.08)
	local RE = ReplicatedStorage:FindFirstChild("RE")
	if RE then
		local cr = RE:FindFirstChild("1Clea1rTool1s")
		if cr then
			pcall(function() cr:FireServer("RequestingPropName", PROP_NAME_RH, PROP_CAT_RH, PROP_FILTER_RH) end)
		end
	end
	task.wait(0.15)
	pcall(function() tmake:FireServer(chaoPart or workspace.Terrain, posChao) end)
	task.wait(0.7)
	local atuais = rh_pegarMeusProps()
	local novo
	for _, p in ipairs(atuais) do
		if not table.find(antigos, p) then novo = p break end
	end
	if not novo and #atuais > #antigos then novo = atuais[#atuais] end
	if novo then
		pcall(function() novo:PivotTo(CFrame.new(posChao)) end)
		return novo
	end
	return nil
end

local function rh_alinharPivot(prop)
	local ok, bbCF = pcall(function() return prop:GetBoundingBox() end)
	if ok and bbCF then prop.WorldPivot = CFrame.new(bbCF.Position) end
end

local function rh_getRefPart(char, name, r6name)
	if not char then return nil end
	local p = char:FindFirstChild(name)
	if p then return p end
	if r6name then p = char:FindFirstChild(r6name) end
	return p
end

local function rh_getSetCF(prop)
	if not prop then return nil, nil end
	local s = prop:FindFirstChild("SetCurrentCFrame")
	if not s then
		for _, d in ipairs(prop:GetDescendants()) do
			if d.Name == "SetCurrentCFrame" then s = d break end
		end
	end
	if not s then return nil, nil end
	if s:IsA("RemoteFunction") then return s, "function" end
	if s:IsA("RemoteEvent") then return s, "event" end
	if s:IsA("BindableFunction") then return s, "bindablefunc" end
	if s:IsA("BindableEvent") then return s, "bindableev" end
	return s, "unknown"
end

local function rh_destruir()
	RH._gen = (RH._gen or 0) + 1
	RH.mode = "idle"
	RH.parts = {}
	RH.spawnProgress.running = false
	if RH.con then pcall(function() RH.con:Disconnect() end) RH.con = nil end
	if RH.syncCon then pcall(function() task.cancel(RH.syncCon) end) RH.syncCon = nil end
	pcall(function()
		local RE = ReplicatedStorage:FindFirstChild("RE")
		if RE and RE:FindFirstChild("1Clea1rTool1s") then
			RE["1Clea1rTool1s"]:FireServer("ClearAllProps")
		end
	end)
end

-- Loop visual (PivotTo local + guarda _finalCF) — SEM isCharacterOrPlayer (bug corrigido)
local function rh_ativarLoop()
	if RH.con then RH.con:Disconnect() end
	local gen = (RH._gen or 0) + 1
	RH._gen = gen
	RH.con = RS.PreRender:Connect(function()
		if RH.mode == "idle" or RH._gen ~= gen then return end
		local char = rh_getChar()
		if not char then return end
		if RH.mode == "robot" then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			local hrpCF = hrp.CFrame
			local baseCF = hrpCF + Vector3.new(0, RH.offsetY, RH.offsetZ)
			for _, item in ipairs(RH.parts) do
				local p = item.prop
				local refPart = rh_getRefPart(char, item.ref, item.r6)
				if p and p.Parent and refPart then
					local relCF = hrpCF:ToObjectSpace(refPart.CFrame)
					local scaledPos = relCF.Position * RH.baseScale
					local scaledRot = relCF - relCF.Position
					local finalCF = baseCF * CFrame.new(scaledPos) * STAND_UP * scaledRot
					item._finalCF = finalCF
					pcall(function() p:PivotTo(finalCF) end)
				end
			end
		elseif RH.mode == "hammer" then
			local hand = char:FindFirstChild(RH.handBone)
			if not hand then return end
			local handCF = hand.CFrame
			for _, item in ipairs(RH.parts) do
				local p = item.prop
				if p and p.Parent then
					local off = item.off * RH.hammerScale + Vector3.new(0, RH.gripY, 0)
					local finalCF = handCF * CFrame.new(off) * LAY_DOWN
					item._finalCF = finalCF
					pcall(function() p:PivotTo(finalCF) end)
				end
			end
		end
	end)
end

-- Sync de remotes separado (~30ms)
local function rh_ativarSync()
	local gen = RH._gen
	if RH.syncCon then pcall(function() task.cancel(RH.syncCon) end) end
	RH.syncCon = task.spawn(function()
		while RH.mode ~= "idle" and RH._gen == gen do
			for _, item in ipairs(RH.parts) do
				if RH.mode == "idle" or RH._gen ~= gen then return end
				if item.setCF and item._finalCF then
					local remote = item.setCF
					local cf = item._finalCF
					local tipo = item.cfType
					task.spawn(function()
						if tipo == "function" or tipo == "bindablefunc" then
							pcall(function() remote:InvokeServer(cf) end)
						elseif tipo == "event" then
							pcall(function() remote:FireServer(cf) end)
						elseif tipo == "bindableev" then
							pcall(function() remote:Fire(cf) end)
						else
							local ok = pcall(function() remote:InvokeServer(cf) end)
							if not ok then pcall(function() remote:FireServer(cf) end) end
						end
					end)
				end
			end
			task.wait(0.03)
		end
	end)
end

local function rh_spawnRobot()
	if RH.mode ~= "idle" then rh_destruir(); task.wait(0.3) end
	if RH.spawnProgress.running then return end
	RH.mode = "robot"
	RH.parts = {}
	RH.spawnProgress.running = true
	RH.spawnProgress.current = 0
	RH.spawnProgress.total = #ROBOT_BODY
	if updateRHStatus then updateRHStatus() end
	task.spawn(function()
		local ok_count = 0
		for i, def in ipairs(ROBOT_BODY) do
			if not RH.spawnProgress.running or RH.mode ~= "robot" then break end
			RH.spawnProgress.current = i
			if updateRHStatus then updateRHStatus() end
			local posChao, chaoPart = rh_getGridPosition(i)
			if not posChao then break end
			local prop = rh_spawnPropAt(posChao, chaoPart)
			if prop then
				for _, d in ipairs(prop:GetDescendants()) do
					if d:IsA("BasePart") then
						pcall(function()
							d.Anchored = true; d.CanCollide = false
							d.CanTouch = false; d.CanQuery = false
							d.Massless = true; d.Material = Enum.Material.SmoothPlastic
						end)
					end
				end
				rh_alinharPivot(prop)
				local setCF, tipo = rh_getSetCF(prop)
				table.insert(RH.parts, {
					prop = prop, ref = def.ref, r6 = def.r6, key = def.key,
					setCF = setCF, cfType = tipo, isRobot = true,
				})
				ok_count = ok_count + 1
			end
			if i < #ROBOT_BODY then task.wait(SPAWN_DELAY_RH) end
		end
		RH.spawnProgress.running = false
		if ok_count > 0 then
			rh_ativarLoop()
			rh_ativarSync()
		else
			RH.mode = "idle"
		end
		if updateRHStatus then updateRHStatus() end
	end)
end

