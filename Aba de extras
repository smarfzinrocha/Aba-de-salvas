local function makeMiniBtn(text, xScale, parent, color, cb)
	local b = Instance.new("TextButton")
	b.Text = text
	b.Size = UDim2.new(0.22, 0, 1, 0)
	b.Position = UDim2.new(xScale, 0, 0, 0)
	b.BackgroundColor3 = color or STYLES.CardColor
	b.TextColor3 = STYLES.TextColor
	b.Font = Enum.Font.SourceSansBold
	b.TextSize = 8
	b.Parent = parent
	applyStyle(b, 3, true)
	b.MouseButton1Click:Connect(cb)
	return b
end

